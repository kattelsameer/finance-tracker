# Finance Tracker Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_USER=financeuser
MYSQL_PASSWORD=change-me-in-production
MYSQL_DATABASE=finance_tracker
MYSQL_PORT=3306

# ============================================
# Backend Configuration
# ============================================
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080

# JWT Configuration (IMPORTANT: Change in production!)
# Generate a secure secret with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-for-jwt-token-generation-change-this-in-production
JWT_EXPIRATION_MS=3600000

# Java Options
JAVA_OPTS=-Xms256m -Xmx512m

# Logging
LOGGING_LEVEL=INFO

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=80

# ============================================
# General Configuration
# ============================================
TZ=UTC

# ============================================
# Production Security Notes
# ============================================
# 1. Generate a strong JWT_SECRET:
#    openssl rand -base64 64
#
# 2. Use strong database passwords:
#    openssl rand -base64 32
#
# 3. Enable HTTPS in production using a reverse proxy (nginx/traefik)
#
# 4. Restrict database access in production (remove port mapping)
#
# 5. Consider using Docker secrets for sensitive values
