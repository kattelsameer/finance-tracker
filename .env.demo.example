# Finance Tracker - Demo Mode Environment Variables
# Copy this file to .env for demo mode

# MySQL Configuration
MYSQL_ROOT_PASSWORD=demo_root_pass_change_me
MYSQL_USER=financeuser
MYSQL_PASSWORD=demo_finance_pass_change_me

# JWT Configuration (REQUIRED - Must be at least 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-very-secure-demo-jwt-secret-key-here-change-this

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:81,http://localhost:8081

# Demo Mode (automatically set by docker-compose.demo.yml)
# SPRING_PROFILES_ACTIVE=demo
# VITE_DEMO_MODE=true
